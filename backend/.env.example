# App
APP_NAME=AI Stylist API
DEBUG=true
API_V1_PREFIX=/api/v1
# Public origin of this service (for absolute /storage/... URLs in API responses). Production: https://xxx.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Database (Render: you can paste postgresql://... from the dashboard — the app rewrites it for asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/krg_stylist
# Optional: force SSL off for local (default on Render via RENDER env)
# DATABASE_SSL=false
# asyncpg TLS: strict cert verify (optional; Render often needs default = skip verify in app)
# DATABASE_SSL_VERIFY=true

# JWT Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# External APIs
OPENAI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
MAPP_FASHION_API_KEY=
MAPP_FASHION_BASE_URL=
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1

# Redis (optional)
REDIS_URL=

# Image Storage
IMAGE_STORAGE_PATH=./storage/images
IMAGE_RETENTION_HOURS=24

# Rate Limits
TRYON_RATE_LIMIT_PER_USER=20
TRYON_RATE_LIMIT_WINDOW_MINUTES=60

# Business Rules
BUDGET_TOLERANCE_PERCENT=5.0
MAX_OUTFITS_PER_REQUEST=10
DEFAULT_OUTFITS_COUNT=3

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
