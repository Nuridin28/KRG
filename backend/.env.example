# App
APP_NAME=AI Stylist API
DEBUG=true
API_V1_PREFIX=/api/v1
# Public origin of this service (for absolute /storage/... URLs in API responses). Production: https://xxx.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Database (Render: you can paste postgresql://... from the dashboard — the app rewrites it for asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/krg_stylist
# Optional: force SSL off for local (default on Render via RENDER env)
# DATABASE_SSL=false
# asyncpg TLS: strict cert verify (optional; Render often needs default = skip verify in app)
# DATABASE_SSL_VERIFY=true

# JWT Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# External APIs
OPENAI_API_KEY=
# --- Vertex AI (Virtual Try-On + Veo «в движении») ---
# 1) GCP: enable Vertex AI API + billing; service account with role "Vertex AI User"
#    (roles/aiplatform.user); JSON key. VTO model: virtual-try-on-001 (see GCP docs for regions).
# 2) Project and region (must match endpoint, e.g. us-central1). Пусто = try-on/Veo в mock или fallback.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
# 3) Credentials — one of:
#    A) Render Secret File → GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/your-file.json
#    B) Paste JSON into GCP_SERVICE_ACCOUNT_JSON (app writes temp file)
#    C) Local: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# При ошибках mTLS в google-auth:
# GOOGLE_API_USE_CLIENT_CERTIFICATE=false

MAPP_FASHION_API_KEY=
MAPP_FASHION_BASE_URL=
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1

# Redis (optional)
REDIS_URL=

# Image Storage
IMAGE_STORAGE_PATH=./storage/images
IMAGE_RETENTION_HOURS=24

# Rate Limits
TRYON_RATE_LIMIT_PER_USER=20
TRYON_RATE_LIMIT_WINDOW_MINUTES=60

# Business Rules
BUDGET_TOLERANCE_PERCENT=5.0
MAX_OUTFITS_PER_REQUEST=10
DEFAULT_OUTFITS_COUNT=3

# CORS (comma-separated or JSON array). Add your production frontend origin(s).
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:3000"]
# Optional: regex for extra origins (default allows any https://*.vercel.app). Set to empty to disable.
# CORS_ORIGIN_REGEX=
